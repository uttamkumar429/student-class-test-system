{
  "name": "server",
  "version": "1.0.0",
  "description": "Production-ready Student Class Test & Result Management System built with Node.js, Express.js, MongoDB and JWT Authentication.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "test:coverage": "cross-env NODE_ENV=test jest --coverage",
    "test:auth": "cross-env NODE_ENV=test jest tests/auth",
    "test:student": "cross-env NODE_ENV=test jest tests/student",
    "test:admin": "cross-env NODE_ENV=test jest tests/admin"
  },
  "keywords": [
    "nodejs",
    "express",
    "mongodb",
    "jwt",
    "student-management",
    "exam-system",
    "education",
    "api",
    "backend",
    "jest"
  ],
  "author": "Uttam",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.3",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "nanoid": "^6.0.0",
    "pdfkit": "^0.19.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}
